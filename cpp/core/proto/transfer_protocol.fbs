// Defines the protocol for the single-pipeline file transfer system.
namespace transfer.protocol;

/// Enum representing the type of message in the payload.
enum MessageType : byte {
    Handshake,        // Sent by the sender to initiate a transfer.
    HandshakeAck,     // Sent by the receiver to acknowledge the handshake.
    DataChunk,        // A chunk of the file being transferred.
    TransferComplete, // Sent by the sender when the file is fully transferred.
    Error             // Sent by either peer if an error occurs.
}

/// The initial message sent by the sender to describe the file.
table Handshake {
    /// The name of the file being sent.
    file_name: string;
    /// The total size of the file in bytes.
    total_size: uint64;
}

/// The receiver's response to the Handshake.
table HandshakeAck {
    /// The byte offset from which the sender should start (or resume) sending.
    resume_offset: uint64;
}

/// A chunk of the file's binary data.
table DataChunk {
    /// The byte offset of this chunk within the original file.
    offset: uint64;
    /// The raw binary data of the chunk.
    payload: [ubyte];
}

/// A message indicating the end of the transfer.
table TransferComplete {
    /// True if the transfer was successful, false otherwise.
    success: bool;
}

/// A message describing an error that occurred.
table Error {
    /// An error code for programmatic handling.
    code: int32;
    /// A human-readable error message.
    message: string;
}

/// A union that can hold any of the message payload types.
union MessagePayload {
    Handshake,
    HandshakeAck,
    DataChunk,
    TransferComplete,
    Error
}

/// The root message container.
table Message {
    /// The type of the payload.
    message_type: MessageType;
    /// The actual message payload.
    payload: MessagePayload;
}

/// The root type for any message sent over the wire.
root_type Message;
